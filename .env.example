# Names only. Copy to .env and fill in locally. Never commit real values.

# Postgres connection string (hosted Postgres in production)
DATABASE_URL=
# Direct (non-pooled) connection used by prisma migrate, if your host pools connections
DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=

# AI extraction. Leave LLM_API_KEY empty to use the labelled mock provider.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=
# Customer RFQs are under NDA. A key alone does NOT enable the live model; set this to "yes" only after
# the AI vendor's data-use and retention terms have been reviewed and approved for customer RFQ text.
LLM_DATA_USE_APPROVED=

# Only for `npm run test:integration`: a throwaway local database (name must contain "test"); it is WIPED on every run.
TEST_DATABASE_URL=
